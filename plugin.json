{
  "id": "itch",
  "name": "itch.io",
  "version": "0.1.2",
  "repository": "github:AzPepoze/light-launcher-plugin-itch",
  "apiVersion": "1",
  "minHost": "2.0.0",
  "entry": {
    "linux-x64": "bin/linux-x64/itch",
    "windows-x64": "bin/windows-x64/itch.exe"
  },
  "contributes": {
    "sources": [
      {
        "id": "itch",
        "label": "itch.io",
        "tile": "poster",
        "capabilities": ["browse", "browse:filters", "auth", "updateCheck", "resolveFiles", "sync:games", "listGames"],
        "sidebar": [
          { "type": "search", "id": "text", "placeholder": "Search itch.io" },
          {
            "type": "select",
            "id": "price",
            "label": "Price",
            "options": [
              { "value": "all", "label": "All prices" },
              { "value": "free", "label": "Free" },
              { "value": "paid", "label": "Paid" }
            ]
          },
          {
            "type": "select",
            "id": "classification",
            "label": "Type",
            "options": [
              { "value": "games", "label": "Games" },
              { "value": "assets", "label": "Assets" },
              { "value": "mods", "label": "Mods" }
            ]
          },
          {
            "type": "sort",
            "id": "sort",
            "options": [
              { "value": "popular", "label": "Popular" },
              { "value": "new", "label": "New" },
              { "value": "updated", "label": "Updated" }
            ],
            "default": { "value": "popular", "order": "desc" }
          }
        ]
      }
    ],
    "settings": { "$ref": "settings.schema.json" },
    "commands": [
      {
        "id": "import-desktop-key",
        "label": "Import itch.io key from the itch app",
        "method": "itch.importDesktopKey"
      }
    ]
  },
  "permissions": {
    "network": ["itch.io", "*.itch.io", "*.itch.zone"],
    "fs": ["$APPDATA_ITCH", "$GAMES"],
    "secrets": true
  }
}
