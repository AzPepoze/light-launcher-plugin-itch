{
  "name": "light-launcher-plugin-itch",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "itch.io source plugin for Light Launcher.",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "llp validate",
    "pack": "llp pack --out dist",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/main.ts --outfile bin/linux-x64/itch",
    "build:windows": "bun build --compile --target=bun-windows-x64 src/main.ts --outfile bin/windows-x64/itch.exe"
  },
  "dependencies": {
    "@light-launcher/plugin-sdk": "file:../light-launcher-plugin-sdk",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
